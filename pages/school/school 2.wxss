.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  background: #0f766e;
  color: #fff;
  border-radius: 16rpx;
  padding: 34rpx 28rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.panel {
  margin-top: 22rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 35, 43, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
  border-bottom: 1rpx solid #edf1f3;
}

.row:last-child {
  border-bottom: 0;
}

.label {
  color: #66737a;
  font-size: 26rpx;
}

.value {
  color: #172126;
  font-size: 28rpx;
  font-weight: 700;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.body {
  margin-top: 18rpx;
  color: #374349;
  font-size: 26rpx;
  line-height: 1.6;
}

.muted {
  color: #66737a;
}
