/* 学校详情样式 */

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.err-box {
  margin-top: 40rpx;
  background: #fff1f2;
  border: 1rpx solid #fecdd3;
  border-radius: 16rpx;
  padding: 32rpx;
  font-size: 27rpx;
  color: #be123c;
  line-height: 1.7;
}
.err-hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #9f1239;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

/* ---------- 头部 ---------- */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.head-left {
  flex: 1;
  min-width: 0;
}
.head-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.4;
}
.head-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
.tag {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin: 0 10rpx 8rpx 0;
  background: #eef2ff;
  color: #4338ca;
}
.tag-gray {
  background: #f1f5f9;
  color: #64748b;
}
.head-right {
  flex-shrink: 0;
  text-align: right;
  padding-left: 16rpx;
}
.forecast-score {
  font-size: 56rpx;
  font-weight: 600;
  color: #2563eb;
  line-height: 1.1;
}
.forecast-label {
  font-size: 21rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* ---------- 指标 ---------- */
.stats {
  display: flex;
  flex-wrap: wrap;
}
.stat {
  width: 50%;
  padding: 8rpx 0;
  box-sizing: border-box;
}
.stat-label {
  font-size: 22rpx;
  color: #94a3b8;
}
.stat-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e293b;
  margin-top: 4rpx;
}

/* ---------- 趋势 ---------- */
.section-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 6rpx;
}
.section-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  height: 56rpx;
}
.row-year {
  width: 84rpx;
  font-size: 24rpx;
  color: #475569;
  flex-shrink: 0;
}
.row-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.row-bar {
  height: 100%;
  background: #2563eb;
  border-radius: 8rpx;
}
.row-line {
  width: 90rpx;
  text-align: right;
  font-size: 25rpx;
  font-weight: 600;
  color: #0f172a;
  flex-shrink: 0;
}
.row-rate {
  width: 100rpx;
  text-align: right;
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
}
.legend {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #94a3b8;
}

/* ---------- 明细表 ---------- */
.tbl {
  margin-top: 12rpx;
}
.tbl-head,
.tbl-row {
  display: flex;
  align-items: center;
  height: 64rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.tbl-head {
  font-size: 22rpx;
  color: #94a3b8;
}
.tbl-row {
  font-size: 26rpx;
  color: #334155;
}
.tbl-row:last-child {
  border-bottom: none;
}
.c-year {
  width: 110rpx;
  flex-shrink: 0;
}
.c-num {
  flex: 1;
  text-align: right;
}
.strong {
  font-weight: 600;
  color: #0f172a;
}

.footer {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
}
