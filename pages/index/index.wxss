/* 首页样式 */

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ---------- 顶部 ---------- */
.hero {
  padding: 16rpx 8rpx 28rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.field {
  margin-bottom: 26rpx;
}
.label {
  font-size: 27rpx;
  color: #334155;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.hint {
  font-size: 23rpx;
  color: #94a3b8;
  font-weight: 400;
}

.input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #0f172a;
  background: #fff;
}
.ph {
  color: #94a3b8;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker .val {
  font-size: 30rpx;
  color: #0f172a;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.picker .ph {
  font-size: 30rpx;
  flex: 1;
}
.arrow {
  color: #94a3b8;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.btn-primary {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #2563eb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}
.btn-primary::after {
  border: none;
}

.err {
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #e11d48;
  line-height: 1.5;
}

/* ---------- 结果摘要 ---------- */
.summary {
  padding: 24rpx 28rpx;
}
.summary-row {
  font-size: 27rpx;
  color: #475569;
  line-height: 1.9;
}
.summary-label {
  color: #64748b;
}
.summary-value {
  color: #0f172a;
  font-weight: 600;
  margin: 0 8rpx;
}
.summary-school {
  color: #0f172a;
  font-weight: 500;
}
.summary-sep {
  color: #cbd5e1;
  margin: 0 16rpx;
}
.notice {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fffbeb;
  border-radius: 10rpx;
  font-size: 23rpx;
  color: #92400e;
  line-height: 1.6;
}

.empty {
  background: #fff;
  border-radius: 20rpx;
  padding: 56rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

/* ---------- 分组 ---------- */
.group {
  margin-bottom: 28rpx;
}
.group-head {
  display: flex;
  align-items: center;
  padding: 0 8rpx 16rpx;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  flex-shrink: 0;
  white-space: nowrap;
}
.group-desc {
  font-size: 23rpx;
  color: #94a3b8;
  margin-left: 12rpx;
  flex: 1;
}
.group-count {
  font-size: 23rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* ---------- 推荐卡片 ---------- */
.rec {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.rec:active {
  background: #f8fafc;
}
.rec-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.rec-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
  line-height: 1.4;
}
.rec-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}
.tag {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin: 0 10rpx 8rpx 0;
  background: #eef2ff;
  color: #4338ca;
}
.tag-gray {
  background: #f1f5f9;
  color: #64748b;
}
.tag-quota {
  background: #ede9fe;
  color: #6d28d9;
}

.rec-right {
  text-align: right;
  flex-shrink: 0;
  width: 160rpx;
}
.rec-score {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}
.rec-score-label {
  font-size: 21rpx;
  color: #94a3b8;
}
.rec-diff {
  margin-top: 6rpx;
  font-size: 23rpx;
  font-weight: 500;
}
.rec-diff.pos {
  color: #059669;
}
.rec-diff.neg {
  color: #e11d48;
}

/* ---------- 建议 ---------- */
.tips {
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 10rpx;
}
.tips-item {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}

.footer {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* ---------- 选校弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 76vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}
.sheet-close {
  font-size: 26rpx;
  color: #2563eb;
  padding: 8rpx 12rpx;
}
.sheet-search {
  margin: 0 28rpx 12rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  background: #f1f5f9;
  border-radius: 10rpx;
  font-size: 27rpx;
}
.sheet-list {
  flex: 1;
  max-height: 56vh;
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
}
.sheet-item {
  padding: 24rpx 8rpx;
  font-size: 28rpx;
  color: #1e293b;
  border-bottom: 1rpx solid #f1f5f9;
}
.sheet-item:active {
  background: #f8fafc;
}
.sheet-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #94a3b8;
}
