.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  background: #0f766e;
  color: #fff;
  border-radius: 16rpx;
  padding: 34rpx 30rpx;
}

.eyebrow {
  font-size: 24rpx;
  opacity: 0.86;
}

.title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.notice {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #f5c56f;
  background: #fff7e6;
  color: #7a4c08;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.panel,
.summary,
.batch,
.rules {
  margin-top: 22rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 35, 43, 0.06);
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
}

.field-help {
  margin-top: 8rpx;
  color: #66737a;
  font-size: 24rpx;
}

.score-input {
  margin-top: 14rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d9e0e3;
  border-radius: 12rpx;
  font-size: 36rpx;
  background: #fbfcfd;
  box-sizing: border-box;
}

.panel > .field-label:not(:first-child) {
  margin-top: 26rpx;
}

.quota-notice {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  background: #f3f7f8;
  border-left: 6rpx solid #0f766e;
}

.picker-block {
  margin-top: 26rpx;
}

.picker-value {
  margin-top: 14rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d9e0e3;
  border-radius: 12rpx;
  background: #fbfcfd;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 88rpx;
}

.placeholder {
  color: #98a2a8;
}

.switch-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.primary-btn {
  margin-top: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #0f766e;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.error {
  margin-top: 18rpx;
  color: #b42318;
  font-size: 26rpx;
}

.summary {
  border-left: 8rpx solid #0f766e;
}

.summary-warn {
  border-left-color: #d97706;
}

.summary-score {
  font-size: 42rpx;
  font-weight: 800;
}

.summary-text,
.line {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #445158;
}

.section-title {
  margin: 34rpx 4rpx 0;
  font-size: 30rpx;
  font-weight: 700;
}

.batch-head,
.school {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.batch-title {
  font-size: 30rpx;
  font-weight: 700;
}

.batch-count {
  color: #66737a;
  font-size: 24rpx;
}

.empty {
  margin-top: 18rpx;
  color: #66737a;
  font-size: 25rpx;
}

.school {
  margin-top: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #edf1f3;
  gap: 20rpx;
}

.school-main {
  min-width: 0;
  flex: 1;
}

.school-name {
  font-size: 29rpx;
  font-weight: 700;
}

.school-meta,
.school-note {
  margin-top: 8rpx;
  color: #66737a;
  font-size: 23rpx;
  line-height: 1.45;
}

.risk {
  width: 112rpx;
  min-height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.risk-label {
  font-size: 22rpx;
  font-weight: 700;
}

.gap {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.warn {
  color: #8a4a00;
  background: #fff1d6;
}

.ok {
  color: #0f5f56;
  background: #dff5ef;
}

.calm {
  color: #24527a;
  background: #e5f1ff;
}

.danger {
  color: #a32016;
  background: #fee4e2;
}

.rule {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf1f3;
  font-size: 25rpx;
  line-height: 1.55;
  color: #374349;
}

.rule:last-child {
  border-bottom: 0;
}
