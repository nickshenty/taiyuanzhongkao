<view class="page">
  <!-- 顶部说明 -->
  <view class="hero">
    <view class="hero-title">太原中考志愿推荐</view>
    <view class="hero-sub">
      输入中考分数与就读初中，按 冲 / 稳 / 保 三档给出 {{targetYear}} 年志愿参考
    </view>
  </view>

  <!-- 输入区 -->
  <view class="card">
    <view class="field">
      <view class="label">中考分数</view>
      <input
        class="input"
        type="digit"
        value="{{score}}"
        placeholder="例如 700"
        placeholder-class="ph"
        bindinput="onScoreInput"
      />
    </view>

    <view class="field">
      <view class="label">
        就读初中学校
        <text class="hint">（影响定向名额）</text>
      </view>
      <view class="input picker" bindtap="openJuniorPicker">
        <text class="{{junior ? 'val' : 'ph'}}">
          {{junior ? junior.name : '点击选择学校'}}
        </text>
        <text class="arrow">›</text>
      </view>
    </view>

    <button class="btn-primary" loading="{{loading}}" bindtap="onSubmit">
      生成志愿推荐方案
    </button>

    <view class="err" wx:if="{{error}}">{{error}}</view>
  </view>

  <!-- 结果摘要 -->
  <block wx:if="{{result}}">
    <view class="card summary">
      <view class="summary-row">
        <text class="summary-label">考生分数</text>
        <text class="summary-value">{{result.studentScore}}</text>
        <text class="summary-sep">|</text>
        <text class="summary-label">就读</text>
        <text class="summary-school">{{result.juniorSchool.name}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">目标年份</text>
        <text class="summary-value">{{result.targetYear}}</text>
        <text class="summary-sep">|</text>
        <text class="summary-label">共推荐</text>
        <text class="summary-value">{{result.totalRecommendations}}</text>
        <text class="summary-label">所</text>
      </view>
      <view class="notice" wx:if="{{quotaNote}}">{{quotaNote}}</view>
    </view>

    <view class="empty" wx:if="{{groups.length === 0}}">
      暂无可推荐学校。分数可能低于所有学校预测线，或与预测线分差超出推荐区间
      （冲：低 5–10 分，稳：±5 分，保：高 10 分以上）。
    </view>

    <!-- 冲 / 稳 / 保 -->
    <view class="group" wx:for="{{groups}}" wx:key="key">
      <view class="group-head">
        <view class="dot" style="background:{{item.color}}"></view>
        <text class="group-title">{{item.label}}</text>
        <text class="group-desc">{{item.desc}}</text>
        <text class="group-count">{{item.list.length}} 所</text>
      </view>

      <view
        class="rec"
        wx:for="{{item.list}}"
        wx:for-item="s"
        wx:key="schoolCode"
        data-code="{{s.schoolCode}}"
        bindtap="toSchool"
      >
        <view class="rec-main">
          <view class="rec-name">{{s.schoolName}}</view>
          <view class="rec-tags">
            <text class="tag" wx:if="{{s.type}}">{{s.type}}</text>
            <text class="tag tag-gray" wx:if="{{s.district}}">{{s.district}}</text>
            <text
              class="tag"
              style="color:{{s.conf.color}};background:{{s.conf.bg}}"
            >{{s.conf.label}}</text>
            <text class="tag tag-quota" wx:if="{{s.quotaUpgraded}}">定向可冲</text>
            <text class="tag tag-gray" wx:elif="{{s.hasDirectedQuota}}">有定向名额</text>
          </view>
        </view>

        <view class="rec-right">
          <view class="rec-score" style="color:{{item.color}}">{{s.predictedScore}}</view>
          <view class="rec-score-label">{{targetYear}} 预测线</view>
          <view class="rec-diff {{s.scoreDiff >= 0 ? 'pos' : 'neg'}}">
            {{s.diffText}} 分
          </view>
        </view>
      </view>
    </view>

    <!-- 建议 -->
    <view class="tips" wx:if="{{result.tips.length}}">
      <view class="tips-title">填报建议</view>
      <view class="tips-item" wx:for="{{result.tips}}" wx:key="*this">· {{item}}</view>
    </view>
  </block>

  <view class="footer">{{disclaimer}}</view>

  <!-- 选校弹层 -->
  <view class="mask" wx:if="{{juniorOpen}}" bindtap="closeJuniorPicker"></view>
  <view class="sheet" wx:if="{{juniorOpen}}" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">选择就读初中</text>
      <text class="sheet-close" bindtap="closeJuniorPicker">关闭</text>
    </view>
    <input
      class="sheet-search"
      placeholder="输入校名搜索，如 太原市第二中学校"
      placeholder-class="ph"
      value="{{keyword}}"
      bindinput="onJuniorSearch"
    />
    <scroll-view class="sheet-list" scroll-y>
      <view
        class="sheet-item"
        wx:for="{{filteredJuniors}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="pickJunior"
      >
        {{item.name}}
      </view>
      <view class="sheet-empty" wx:if="{{filteredJuniors.length === 0}}">没有匹配的学校</view>
    </scroll-view>
  </view>
</view>
