<view class="page">
  <view class="hero">
    <view>
      <view class="eyebrow">{{data.city}} · {{data.yearLabel}}</view>
      <view class="title">中考志愿报名咨询</view>
      <view class="subtitle">输入分数后，按批次展示冲、稳、保建议和填报风险。</view>
    </view>
  </view>

  <view class="notice">{{data.dataStatus}}</view>

  <view class="panel">
    <view class="field-label">数据年份</view>
    <picker mode="selector" range="{{availableYears}}" value="{{selectedYearIndex}}" bindchange="onYearChange">
      <view class="picker-value">{{data.yearLabel}} 年</view>
    </picker>

    <view class="field-label">中考分数</view>
    <input class="score-input" type="digit" value="{{score}}" maxlength="5" placeholder="例如 735.1" bindinput="onScoreInput" />

    <view class="switch-row">
      <view>
        <view class="field-label">是否具备定向生资格</view>
        <view class="field-help">定向资格以毕业学校和当年审核结果为准</view>
      </view>
      <switch color="#0F766E" checked="{{hasQuota}}" bindchange="onQuotaChange" />
    </view>

    <view wx:if="{{hasQuota && data.quotaAllocationReady}}" class="picker-block">
      <view class="field-label">初中就读学校</view>
      <picker mode="selector" range="{{juniorSchoolNames}}" value="{{selectedJuniorSchoolIndex}}" bindchange="onJuniorSchoolChange">
        <view class="picker-value {{selectedJuniorSchoolName ? '' : 'placeholder'}}">
          {{selectedJuniorSchoolName ? selectedJuniorSchoolName : '请选择初中学校'}}
        </view>
      </picker>
      <view class="field-help" wx:if="{{data.quotaAllocationReady}}">用于匹配该初中分配到各高中的定向名额</view>
    </view>

    <view wx:if="{{hasQuota && !data.quotaAllocationReady}}" class="field-help quota-notice">
      {{data.yearLabel}}年指标到校表待补充，当前按定向二次分配线提供参考，无需选择初中学校。
    </view>

    <button class="primary-btn" bindtap="onRecommend">生成推荐</button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{result.ok}}" class="result">
    <view class="summary {{result.belowControlLine ? 'summary-warn' : ''}}">
      <view class="summary-score">{{result.scoreDisplay}} 分</view>
      <view class="summary-text">{{result.summary}}</view>
      <view wx:if="{{result.juniorSchoolName}}" class="line">定向匹配初中：{{result.juniorSchoolName}}</view>
      <view class="line">{{data.yearLabel}}年普通高中最低录取控制线：{{data.minControlLine}} 分</view>
    </view>

    <view class="section-title">按太原志愿规则分栏展示</view>
    <block wx:for="{{result.ladder}}" wx:key="key">
      <view class="batch">
        <view class="batch-head">
          <view class="batch-title">{{item.title}}</view>
          <view class="batch-count">{{item.items.length}} 所</view>
        </view>

        <view wx:if="{{item.items.length == 0}}" class="empty">暂无适合展示的学校，请调整分数或补充当年数据。</view>

        <block wx:for="{{item.items}}" wx:for-item="school" wx:key="id">
          <view class="school" bindtap="openSchool" data-id="{{school.id}}" data-batch="{{school.batch}}">
            <view class="school-main">
              <view class="school-name">{{school.name}}</view>
              <view class="school-meta">代码 {{school.code}} · {{school.type}} · {{school.district}}</view>
              <view class="school-meta">{{school.planNote}}</view>
              <view class="school-note">{{school.note}}</view>
            </view>
            <view class="risk {{school.tone}}">
              <view class="risk-label">{{school.riskLabel}}</view>
              <view class="gap">{{school.gapDisplay}}</view>
            </view>
          </view>
        </block>
      </view>
    </block>

    <view class="section-title">填报规则提醒</view>
    <view class="rules">
      <block wx:for="{{data.rules}}" wx:key="*this">
        <view class="rule">{{index + 1}}. {{item}}</view>
      </block>
    </view>
  </view>
</view>
