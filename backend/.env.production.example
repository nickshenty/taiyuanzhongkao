# 生产环境配置示例
# 复制为 backend/.env 后按实际修改；切勿把真实 .env 提交到 Git

NODE_ENV=production
PORT=3002
# 生产环境建议只监听回环，由 Nginx 反向代理对外
HOST=127.0.0.1

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=taiyuan
DB_PASSWORD=请改成强密码
DB_NAME=taiyuan_zhongkao

# ---------- 跨域 ----------
# 前后端同域部署（Nginx 同站点）时前端走相对路径 /api，无需跨域；
# 若前端单独部署在其它域名，在此填写，多个用英文逗号分隔。
# 例：CORS_ORIGIN=https://zk.example.com,https://www.example.com
CORS_ORIGIN=

# 位于 Nginx 之后，信任 1 层代理以获取真实客户端 IP（限流按 IP 计数）
TRUST_PROXY=1

# ---------- 限流（可选，均有默认值）----------
# 全局限流：每 RATE_WINDOW_MS 毫秒内最多 RATE_MAX 次
RATE_WINDOW_MS=60000
RATE_MAX=300
# 推荐接口单独限流（计算较重）
REC_RATE_WINDOW_MS=60000
REC_RATE_MAX=60

# 请求体大小上限
BODY_LIMIT=256kb
