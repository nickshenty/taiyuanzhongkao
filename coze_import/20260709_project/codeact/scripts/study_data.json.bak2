      },
      "english": {
        "topic": "词汇巩固 + 阅读训练",
        "key_points": [
          "词汇巩固",
          "阅读训练",
          "综合复习"
        ],
        "practice_guide": "词汇巩固+阅读训练：词汇巩固，阅读训练。"
      },
      "physics": {
        "topic": "功能关系与机械能守恒实验",
        "content": "功能关系描述不同力做功与不同形式能量变化的对应关系。重力做功等于重力势能变化的负值：WG=-ΔEp=mgh₁-mgh₂。合外力做功等于动能变化：W合=ΔEk。除重力外其他力做功等于机械能变化：W其他=ΔE机。摩擦力做功（一对滑动摩擦力）等于系统内能增加：Q=f·Δs（Δs为相对位移）。利用功能关系可以灵活处理各种能量转化问题，关键是明确哪个力做功对应哪种能量变化。功能关系是连接力和能量的桥梁，不同力做功对应不同形式的能量变化。\n\n验证机械能守恒定律的实验常用自由落体法：通过打点计时器记录重物下落的运动，测量各点速度和下落高度，验证½mv²=mgh是否成立。实验要点：①打点计时器安装竖直，纸带竖直穿过；②重物质量大些好（减小空气阻力影响）；③先接通电源再释放纸带；④选第一、二点间距约2mm的纸带（保证初速度为零）。数据处理：用v=gT或逐差法求速度，计算Ek和Ep比较。实验误差来源：空气阻力、纸带摩擦、测量误差等，导致Ek略小于mgh。",
        "key_points": [
          "重力做功：WG=-ΔEp（重力势能变化的负值）",
          "合外力做功：W合=ΔEk（动能变化）",
          "其他力做功：W其他=ΔE机（机械能变化）",
          "摩擦力做功：Q=f·Δs（内能增加，Δs为相对位移）",
          "不同力做功对应不同能量变化",
          "实验原理：验证½mv²=mgh（自由落体中机械能守恒）",
          "纸带选择：第一二点间距约2mm（v₀=0）",
          "先接电源再释放纸带",
          "重物选质量大的（减小空气阻力影响）",
          "误差：Ek<mgh（阻力做负功）"
        ],
        "common_mistakes": [
          "混淆WG=-ΔEp和WG=ΔEp（差一个负号）",
          "摩擦生热中Δs用对地位移而非相对位移",
          "W其他=ΔE机中\"其他力\"不包括重力",
          "实验中用v=gt求速度（应该用纸带数据求）",
          "忘记检查第一二点间距是否约2mm",
          "误差分析时方向搞反（应Ek<mgh）"
        ],
        "formulas": [
          "重力做功：WG = mgh₁ - mgh₂ = -ΔEp",
          "其他力做功：W其他 = ΔE机",
          "摩擦生热：Q = f·Δs",
          "验证方程：½mv² = mgh",
          "瞬时速度：v = (xₙ₊₁ - xₙ₋₁)/(2T)",
          "重力势能减少：ΔEp = mgh"
        ],
