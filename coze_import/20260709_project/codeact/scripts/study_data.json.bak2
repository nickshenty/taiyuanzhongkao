          "θ=90°：垂直，a·b=0",
          "θ=180°：反向，a·b=-|a||b|（最小）",
          "a⊥b的充要条件：a·b=0"
        ],
        "formulas": [
          "a·b = |a||b|cosθ",
          "坐标运算：a·b = x₁x₂ + y₁y₂",
