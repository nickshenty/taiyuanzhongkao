          "斜抛=水平匀速+竖直匀变速（上抛+自由落体）",
          "初速度分解：v₀x=v₀cosθ，v₀y=v₀sinθ",
          "最高点vy=0，速度为v₀cosθ（水平方向）",
          "射程x=v₀²sin2θ/g，θ=45°时射程最大",
          "飞行时间T=2v₀sinθ/g"
        ],
        "formulas": [
          "水平位移：x = v₀cosθ · t",
          "竖直位移：y = v₀sinθ·t - ½gt²",
          "射程：R = v₀²sin2θ/g",
          "最高高度：H = v₀²sin²θ/(2g)"
        ],
